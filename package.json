{
  "name": "rock-band-online-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/clear-local-song-cache.mjs && next dev --hostname 127.0.0.1 --port 5173",
    "build": "node scripts/clear-local-song-cache.mjs && next build",
    "lint": "eslint .",
    "preview": "next start --hostname 127.0.0.1 --port 5173",
    "test": "node --test tests/*.test.mjs",
    "import:dragonforce": "node scripts/import-songs.mjs",
    "import:songs": "node scripts/import-songs.mjs",
    "start": "next start",
    "assets:songs": "node scripts/prepare-song-assets.mjs",
    "hosting:prepare": "node scripts/export-hosting-song.mjs",
    "firebase:login": "firebase login",
    "hosting:deploy": "firebase deploy --config firebase.assets.json --project riff-lab-maps --only hosting",
    "hosting:publish": "node scripts/publish-hosting-song.mjs"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.34.1",
    "globals": "^17.12.0",
    "midi-file": "^1.2.4",
    "parse-sng": "^4.0.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
